# Copy this file to .env.local for local testing with `vercel dev`.
# Never commit a real key — .env / .env.local are already gitignored.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Powers the "Web search" toggle in the chat's + menu (1,000 free searches/
# month, no card required). Get a free key at https://app.tavily.com.
# Leave blank to skip web search entirely — the toggle just won't find
# anything and the model answers from its own knowledge instead.
TAVILY_API_KEY=

# Stripe Dashboard -> Developers -> API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auto-added when you attach a Redis store via Vercel's Storage tab
# (Marketplace -> Redis) -- you shouldn't need to fill these in by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SendGrid for admin email notifications
# Get a key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Admin notification emails (new Pro signups, heavy-usage alerts).
# Leave blank to skip emails entirely — nothing else depends on this.
ADMIN_EMAIL=redoutbusiness@gmail.com
